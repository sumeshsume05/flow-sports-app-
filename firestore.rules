rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null &&
        exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function isValidStatus(s) {
      return s in ['upcoming', 'live', 'completed'];
    }

    match /teams/{teamId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /matches/{matchId} {
      allow read: if true;
      allow create, update: if isAdmin() &&
        (!('status' in request.resource.data) || isValidStatus(request.resource.data.status));
      allow delete: if isAdmin();
    }

    match /admins/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false; // managed only via Firebase Console, never client writes
    }

    match /config/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /seasons/{seasonId} {
      allow read: if true;
      allow create, update: if isAdmin();
      allow delete: if false; // seasons are never deleted, to protect tournament history
    }
  }
}
