rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null &&
        exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function isValidStatus(s) {
      return s in ['upcoming', 'live', 'completed'];
    }

    // Every count must stay a non-negative int — guards the viewer-writable
    // reaction-toggle path (react +1 / undo -1) below from ever going negative.
    // The map may contain ONLY the known keys: any viewer can write here, and an
    // extra key (or a non-integer value) would otherwise be stored and could
    // break every screen that reads the match.
    function reactionCountsValid(counts) {
      return counts.keys().hasOnly(['thumbsUp', 'fire', 'wow']) &&
        (!('thumbsUp' in counts) || (counts.thumbsUp is int && counts.thumbsUp >= 0)) &&
        (!('fire' in counts) || (counts.fire is int && counts.fire >= 0)) &&
        (!('wow' in counts) || (counts.wow is int && counts.wow >= 0));
    }

    // Same non-negative-int guard as reactionCountsValid, for the
    // viewer-writable prediction-cast/switch path below.
    function predictionCountsValid(counts) {
      return counts.keys().hasOnly(['teamA', 'teamB']) &&
        (!('teamA' in counts) || (counts.teamA is int && counts.teamA >= 0)) &&
        (!('teamB' in counts) || (counts.teamB is int && counts.teamB >= 0));
    }

    // config/chatSettings not existing yet means chat has never been
    // toggled off — defaults to enabled so this is backward compatible.
    // This is the enforcement layer that actually matters: the app is a
    // sideloaded APK shared outside any app store, so an admin turning chat
    // off must also stop old, never-updated copies from still posting.
    function chatIsEnabled() {
      return !exists(/databases/$(database)/documents/config/chatSettings) ||
        get(/databases/$(database)/documents/config/chatSettings).data.enabled != false;
    }

    match /teams/{teamId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /matches/{matchId} {
      allow read: if true;
      allow create, update: if isAdmin() &&
        (!('status' in request.resource.data) || isValidStatus(request.resource.data.status));
      allow delete: if isAdmin();

      // Viewers may react/undo (bump reaction counts up or down) with no
      // admin auth required — no other field may be touched by this path.
      allow update: if request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reactionCounts']) &&
        reactionCountsValid(request.resource.data.reactionCounts);

      // Viewers may cast/switch a prediction — a switch touches both keys
      // under predictionCounts in one write, but affectedKeys() still only
      // reports the single top-level field, same as the reaction path above.
      allow update: if request.resource.data.diff(resource.data).affectedKeys().hasOnly(['predictionCounts']) &&
        predictionCountsValid(request.resource.data.predictionCounts);

      match /commentary/{entryId} {
        allow read: if true;
        allow create: if isAdmin() &&
          request.resource.data.text is string &&
          request.resource.data.text.size() > 0 &&
          request.resource.data.text.size() <= 200 &&
          request.resource.data.createdAt == request.time;
        allow update, delete: if isAdmin();
      }

      // Live-score +/- point log — append-only: a wrong tap is corrected by
      // a new entry (the admin's own - tap), never by editing or deleting a
      // past one, so the log stays an honest record. The one exception is
      // clean-up after the match itself has been deleted (reset / delete
      // match): then the orphaned entries can go.
      match /pointLog/{entryId} {
        allow read: if true;
        allow create: if isAdmin() &&
          request.resource.data.team in ['A', 'B'] &&
          request.resource.data.scoreA is int && request.resource.data.scoreA >= 0 &&
          request.resource.data.scoreB is int && request.resource.data.scoreB >= 0 &&
          request.resource.data.createdAt == request.time;
        allow update: if false;
        allow delete: if isAdmin() &&
          !exists(/databases/$(database)/documents/matches/$(matchId));
      }
    }

    match /admins/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false; // managed only via Firebase Console, never client writes
    }

    match /config/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /seasons/{seasonId} {
      allow read: if true;
      allow create, update: if isAdmin();
      allow delete: if false; // seasons are never deleted, to protect tournament history
    }

    match /chatMessages/{messageId} {
      allow read: if true;
      // No auth required to post — a locally chosen display name stands in
      // for identity. request.time forces a real server timestamp (via
      // FieldValue.serverTimestamp()), blocking a spoofed/backdated one.
      allow create: if chatIsEnabled() &&
        request.resource.data.text is string &&
        request.resource.data.text.size() > 0 &&
        request.resource.data.text.size() <= 280 &&
        request.resource.data.authorName is string &&
        request.resource.data.authorName.size() >= 4 &&
        request.resource.data.authorName.size() <= 24 &&
        request.resource.data.authorDeviceId is string &&
        request.resource.data.createdAt == request.time &&
        request.resource.data.season is string;
      // Messages are immutable to viewers once posted; admin can moderate.
      allow update, delete: if isAdmin();
    }

    // One doc per device (doc id = the device's own locally-generated,
    // persisted id — see LocalIdentityService), used only to give the
    // admin a rough install/active-now count. No auth required to write
    // (same trust level as reactions/chat), but only admin can read —
    // there's no reason to expose the raw device list to viewers.
    match /presence/{deviceId} {
      allow read: if isAdmin();
      allow create: if request.resource.data.deviceId == deviceId &&
        request.resource.data.firstSeenAt == request.time &&
        request.resource.data.lastSeenAt == request.time;
      allow update: if request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastSeenAt', 'appVersion']) &&
        request.resource.data.lastSeenAt == request.time;
      allow delete: if false;
    }
  }
}
